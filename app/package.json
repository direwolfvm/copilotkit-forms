{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:style-tokens": "bash ./scripts/check-style-literals.sh",
    "sync:env:gcloud": "bash ./scripts/sync-env-from-gcloud.sh",
    "preview": "vite preview",
    "start": "node server.mjs",
    "deploy:cloud": "node scripts/deploy-cloud.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:bench": "vitest bench",
    "test:e2e": "playwright test",
    "license-check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;MIT*;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC0-1.0;0BSD;Unlicense;MPL-2.0;Zlib;AFL-2.1\" --excludePackagesStartingWith \"@uswds/uswds;intro.js\"",
    "sbom": "cyclonedx-npm --omit dev --output-file sbom.cdx.json"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.79.1",
    "@copilotkit/react-ui": "1.79.1",
    "@rjsf/core": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "@tmcw/togeojson": "^5.4.0",
    "@uswds/uswds": "^3.14.0",
    "express": "^4.21.2",
    "intro.js": "^8.6.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.4",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  },
  "copilotkit": {
    "runtime": "1.79.1"
  }
}
