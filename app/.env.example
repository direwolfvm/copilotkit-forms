# CopilotKit runtime (recommended same-origin route used by the frontend)
VITE_COPILOTKIT_RUNTIME_URL=/api/copilotkit-runtime

# Server-side upstreams for the default runtime, optional Permitting ADK mode,
# and project-aware NEPA questions/environmental maps.
COPILOTKIT_RUNTIME_PROXY_BASE_URL=
COPILOTKIT_CUSTOM_ADK_URL=
NEPA_MCP_WEB_BASE_URL=

# Canonical portal Supabase credentials (required for persistence).
# Use an anon/public key, never a service-role key. Find the tenant UUID with:
# select id from public.tenant where slug = 'helppermitme';
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_TENANT_ID=

# Portal write Edge Function (server-side only). When set, writes to project, process_instance,
# process_decision_payload, case_event, document and gis_data are forwarded here instead of
# reaching PostgREST as the anon role. The function holds the service credential inside Supabase;
# this server keeps using only the anon key. Unset means writes fall through to PostgREST and
# depend on the shared project's legacy anon write policies.
# e.g. https://<project>.supabase.co/functions/v1/helppermit-portal-write
SUPABASE_PORTAL_WRITE_FUNCTION_URL=

# PermitFast integration (can point to canonical Supabase; always scope with a tenant ID)
PERMITFLOW_SUPABASE_URL=
PERMITFLOW_SUPABASE_ANON_KEY=
PERMITFLOW_TENANT_ID=

# ReviewWorks integration (can point to canonical Supabase; always scope with a tenant ID)
REVIEWWORKS_SUPABASE_URL=
REVIEWWORKS_SUPABASE_ANON_KEY=
REVIEWWORKS_TENANT_ID=

# Section 106 Case Manager (Demo) integration — NHPA Section 106 reviews via the
# one-oh-six-bot exchange API. This is a demonstration system, not a system of record.
# The API key is server-side only (used by the /api/section106 proxy, never sent to the
# browser). Key provided by the Case Manager team; a local dev instance accepts
# demo-portal-key automatically. URL defaults to the live demo instance.
SECTION106_EXCHANGE_URL=
SECTION106_EXCHANGE_API_KEY=

# Optional identification headers for IPaC requests
IPAC_CONTACT_EMAIL=
IPAC_ORGANIZATION=
IPAC_PROJECT=

# Express production server
PORT=8080
